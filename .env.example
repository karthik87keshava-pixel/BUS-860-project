# Copy this file to .env.local (on your computer) or add these in Vercel → Settings → Environment Variables.
# Both values are in Supabase → Project Settings (Data API → Project URL; API Keys → Publishable key, sb_publishable_…).
# The publishable key is safe in a browser; never put the secret key (sb_secret_…) anywhere in this project.
SUPABASE_URL=
SUPABASE_PUBLISHABLE=
